# Copy to .env.local. Never use VITE_ prefixes for credentials.
EASYPOST_TEST_API_KEY=
AFTERSHIP_API_KEY=
# Enable only once AfterShip confirms delivery prediction access.
AFTERSHIP_EDD_ENABLED=false
# Initial live probe was denied (HTTP 403 / Cloudflare 1010, no retry requested).
# Enable only after SMKlog restores access for this client.
SMKLOG_ENABLED=false

# Baseten AI-generated procurement estimates (server only).
# The same Baseten account key can be used for all three models.
BASETEN_DEEPSEEK_API_KEY=
BASETEN_GLM_FLASH_API_KEY=
BASETEN_GLM_FAST_API_KEY=
# Optional order of the configured models; update from measured performance.
BASETEN_MODEL_ORDER=deepseek,glm_flash,glm_fast

# Persistent procurement estimates: seven-day expiry, server only.
# Managed Redis: paste the provider's TLS TCP connection URL (rediss://).
# Local Docker Compose: redis://127.0.0.1:6379/0
REDIS_URL=
