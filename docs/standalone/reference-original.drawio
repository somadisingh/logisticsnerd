        <object id="ln7nf3-t-businesses" label="" table="businesses" tooltip="Inherited OperationsNerd company. One company per database. Unique/index definitions are available in this table's data." schemaColumns="[{&quot;name&quot;: &quot;id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 1}, {&quot;name&quot;: &quot;name&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;industry_pack&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;pack_version&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;settings_json&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;'{}'&quot;, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;created_at&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;datetime('now')&quot;, &quot;pk&quot;: 0}]" schemaIndexes="[{&quot;name&quot;: &quot;minimal_one_business_per_file&quot;, &quot;unique&quot;: true, &quot;origin&quot;: &quot;c&quot;, &quot;partial&quot;: false, &quot;columns&quot;: [null], &quot;sql&quot;: &quot;CREATE UNIQUE INDEX minimal_one_business_per_file ON businesses((1))&quot;}]" schemaSQL="CREATE TABLE businesses (&#10;    id              INTEGER PRIMARY KEY AUTOINCREMENT,&#10;    name            TEXT NOT NULL,&#10;    industry_pack   TEXT NOT NULL,         -- e.g. 'realestate' -- which Config Pack is loaded&#10;    pack_version    TEXT NOT NULL,&#10;    settings_json   TEXT NOT NULL DEFAULT '{}',  -- questionnaire answers, shape defined by the pack&#10;    created_at      TEXT NOT NULL DEFAULT (datetime('now'))&#10;)" category="core">
          <mxCell style="group;" vertex="1" connectable="0" parent="1">
            <mxGeometry x="40" y="205" width="380" height="232" as="geometry" />
          </mxCell>
        </object>
        <object id="ln7nf3-t-contacts" label="" table="contacts" tooltip="Inherited shared customers and suppliers; existing definition preserved. Unique/index definitions are available in this table's data." schemaColumns="[{&quot;name&quot;: &quot;id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 1}, {&quot;name&quot;: &quot;business_id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;name&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;email&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: false, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;phone&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: false, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;status&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;'active'&quot;, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;created_at&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;datetime('now')&quot;, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;updated_at&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;datetime('now')&quot;, &quot;pk&quot;: 0}]" schemaIndexes="[{&quot;name&quot;: &quot;idx_contacts_business&quot;, &quot;unique&quot;: false, &quot;origin&quot;: &quot;c&quot;, &quot;partial&quot;: false, &quot;columns&quot;: [&quot;business_id&quot;], &quot;sql&quot;: &quot;CREATE INDEX idx_contacts_business ON contacts(business_id)&quot;}]" schemaSQL="CREATE TABLE contacts (&#10;    id              INTEGER PRIMARY KEY AUTOINCREMENT,&#10;    business_id     INTEGER NOT NULL REFERENCES businesses(id),&#10;    name            TEXT NOT NULL,&#10;    email           TEXT,&#10;    phone           TEXT,&#10;    status          TEXT NOT NULL DEFAULT 'active',  -- active | inactive, universal enough to stay core&#10;    created_at      TEXT NOT NULL DEFAULT (datetime('now')),&#10;    updated_at      TEXT NOT NULL DEFAULT (datetime('now'))&#10;)" category="core">
          <mxCell style="group;" vertex="1" connectable="0" parent="1">
            <mxGeometry x="40" y="477" width="380" height="288" as="geometry" />
          </mxCell>
        </object>
        <object id="ln7nf3-t-items" label="" table="items" tooltip="SKU is a candidate key within the selected company database. One stock location. Unique/index definitions are available in this table's data." schemaColumns="[{&quot;name&quot;: &quot;id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 1}, {&quot;name&quot;: &quot;sku&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;name&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;unit&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;'each'&quot;, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;quantity_on_hand&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;0&quot;, &quot;pk&quot;: 0}]" schemaIndexes="[{&quot;name&quot;: &quot;sqlite_autoindex_items_1&quot;, &quot;unique&quot;: true, &quot;origin&quot;: &quot;u&quot;, &quot;partial&quot;: false, &quot;columns&quot;: [&quot;sku&quot;], &quot;sql&quot;: null}]" schemaSQL="CREATE TABLE items (&#10; id INTEGER PRIMARY KEY AUTOINCREMENT,&#10; sku TEXT NOT NULL UNIQUE,&#10; name TEXT NOT NULL,&#10; unit TEXT NOT NULL DEFAULT 'each',&#10; quantity_on_hand INTEGER NOT NULL DEFAULT 0 CHECK(quantity_on_hand&gt;=0)&#10;)" category="shared">
          <mxCell style="group;" vertex="1" connectable="0" parent="1">
            <mxGeometry x="520" y="205" width="380" height="204" as="geometry" />
          </mxCell>
        </object>
        <object id="ln7nf3-t-orders" label="" table="orders" tooltip="Customer order header. Derive open/fulfilled from fulfilled_at. Unique/index definitions are available in this table's data." schemaColumns="[{&quot;name&quot;: &quot;id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 1}, {&quot;name&quot;: &quot;customer_contact_id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;required_by&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;created_at&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;datetime('now')&quot;, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;fulfilled_at&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: false, &quot;default&quot;: null, &quot;pk&quot;: 0}]" schemaIndexes="[]" schemaSQL="CREATE TABLE orders (&#10; id INTEGER PRIMARY KEY AUTOINCREMENT,&#10; customer_contact_id INTEGER NOT NULL REFERENCES contacts(id),&#10; required_by TEXT NOT NULL,&#10; created_at TEXT NOT NULL DEFAULT (datetime('now')),&#10; fulfilled_at TEXT&#10;)" category="logistics">
          <mxCell style="group;" vertex="1" connectable="0" parent="1">
            <mxGeometry x="520" y="449" width="380" height="204" as="geometry" />
          </mxCell>
        </object>
        <object id="ln7nf3-t-order_lines" label="" table="order_lines" tooltip="Original demand, current reservation and frozen original procurement target are distinct facts. Unique/index definitions are available in this table's data." schemaColumns="[{&quot;name&quot;: &quot;id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 1}, {&quot;name&quot;: &quot;order_id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;item_id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;quantity&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;reserved_quantity&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;0&quot;, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;quantity_to_purchase&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;0&quot;, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;maximum_budget_cents&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: false, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;priority&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;'lowest_cost'&quot;, &quot;pk&quot;: 0}]" schemaIndexes="[]" schemaSQL="CREATE TABLE order_lines (&#10; id INTEGER PRIMARY KEY AUTOINCREMENT,&#10; order_id INTEGER NOT NULL REFERENCES orders(id),&#10; item_id INTEGER NOT NULL REFERENCES items(id),&#10; quantity INTEGER NOT NULL CHECK(quantity&gt;0),&#10; reserved_quantity INTEGER NOT NULL DEFAULT 0&#10;   CHECK(reserved_quantity&gt;=0 AND reserved_quantity&lt;=quantity),&#10; quantity_to_purchase INTEGER NOT NULL DEFAULT 0&#10;   CHECK(quantity_to_purchase&gt;=0 AND quantity_to_purchase&lt;=quantity),&#10; maximum_budget_cents INTEGER CHECK(maximum_budget_cents&gt;=0),&#10; priority TEXT NOT NULL DEFAULT 'lowest_cost'&#10;   CHECK(priority IN ('lowest_cost','earliest_delivery'))&#10;)" category="logistics">
          <mxCell style="group;" vertex="1" connectable="0" parent="1">
            <mxGeometry x="520" y="693" width="380" height="288" as="geometry" />
          </mxCell>
        </object>
        <object id="ln7nf3-t-supplier_quotes" label="" table="supplier_quotes" tooltip="Immutable quote terms price the entire frozen line target. recommended_at marks the current recommendation. Unique/index definitions are available in this table's data." schemaColumns="[{&quot;name&quot;: &quot;id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 1}, {&quot;name&quot;: &quot;order_line_id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;supplier_contact_id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;available_quantity&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;total_cost_cents&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;expected_delivery_date&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;source&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;generated_at&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;datetime('now')&quot;, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;recommended_at&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: false, &quot;default&quot;: null, &quot;pk&quot;: 0}]" schemaIndexes="[{&quot;name&quot;: &quot;one_recommended_quote_per_line&quot;, &quot;unique&quot;: true, &quot;origin&quot;: &quot;c&quot;, &quot;partial&quot;: true, &quot;columns&quot;: [&quot;order_line_id&quot;], &quot;sql&quot;: &quot;CREATE UNIQUE INDEX one_recommended_quote_per_line\n ON supplier_quotes(order_line_id) WHERE recommended_at IS NOT NULL&quot;}]" schemaSQL="CREATE TABLE supplier_quotes (&#10; id INTEGER PRIMARY KEY AUTOINCREMENT,&#10; order_line_id INTEGER NOT NULL REFERENCES order_lines(id),&#10; supplier_contact_id INTEGER NOT NULL REFERENCES contacts(id),&#10; available_quantity INTEGER NOT NULL CHECK(available_quantity&gt;=0),&#10; total_cost_cents INTEGER NOT NULL CHECK(total_cost_cents&gt;=0),&#10; expected_delivery_date TEXT NOT NULL,&#10; source TEXT NOT NULL CHECK(source IN ('mock_sample','mock_ai')),&#10; generated_at TEXT NOT NULL DEFAULT (datetime('now')),&#10; recommended_at TEXT&#10;)" category="logistics">
          <mxCell style="group;" vertex="1" connectable="0" parent="1">
            <mxGeometry x="1000" y="205" width="380" height="316" as="geometry" />
          </mxCell>
        </object>
        <object id="ln7nf3-t-purchase_orders" label="" table="purchase_orders" tooltip="id, customer_order_line_id and selected_quote_id are candidate keys. Read immutable commercial terms through the quote and line. Unique/index definitions are available in this table's data." schemaColumns="[{&quot;name&quot;: &quot;id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 1}, {&quot;name&quot;: &quot;customer_order_line_id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;selected_quote_id&quot;, &quot;type&quot;: &quot;INTEGER&quot;, &quot;required&quot;: true, &quot;default&quot;: null, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;confirmed_at&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: true, &quot;default&quot;: &quot;datetime('now')&quot;, &quot;pk&quot;: 0}, {&quot;name&quot;: &quot;received_at&quot;, &quot;type&quot;: &quot;TEXT&quot;, &quot;required&quot;: false, &quot;default&quot;: null, &quot;pk&quot;: 0}]" schemaIndexes="[{&quot;name&quot;: &quot;sqlite_autoindex_purchase_orders_2&quot;, &quot;unique&quot;: true, &quot;origin&quot;: &quot;u&quot;, &quot;partial&quot;: false, &quot;columns&quot;: [&quot;selected_quote_id&quot;], &quot;sql&quot;: null}, {&quot;name&quot;: &quot;sqlite_autoindex_purchase_orders_1&quot;, &quot;unique&quot;: true, &quot;origin&quot;: &quot;u&quot;, &quot;partial&quot;: false, &quot;columns&quot;: [&quot;customer_order_line_id&quot;], &quot;sql&quot;: null}]" schemaSQL="CREATE TABLE purchase_orders (&#10; id INTEGER PRIMARY KEY AUTOINCREMENT,&#10; customer_order_line_id INTEGER NOT NULL UNIQUE REFERENCES order_lines(id),&#10; selected_quote_id INTEGER NOT NULL UNIQUE REFERENCES supplier_quotes(id),&#10; confirmed_at TEXT NOT NULL DEFAULT (datetime('now')),&#10; received_at TEXT&#10;)" category="logistics">
