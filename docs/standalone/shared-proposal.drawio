        <mxCell id="rel-11" value="company + line + SAME item" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#94a3b8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stock_reservations" target="order_lines">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="rel-12" value="transactional balance check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#94a3b8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stock_reservations" target="stock_balances">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="rel-13" value="company; atomic durable result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#94a3b8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="logistics_operations" target="businesses">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="gates" value="&lt;b&gt;Stop before integration&lt;/b&gt;&lt;br&gt;Approve item/stock mapping, company isolation, module contract and split sourcing first.&lt;br&gt;Wider core migrations separately reviewed. Accounting owner/interface unresolved.&lt;br&gt;No SQL migration, backend endpoint, UI connection or production accounting is implemented." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#64748b;align=left;verticalAlign=top;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1400" y="880" width="420" height="210" />
        </mxCell>
      </root>
